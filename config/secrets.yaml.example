# Configuration des secrets recode-icd.
#
# Usage :
#   1. Copier ce fichier en `config/secrets.yaml`
#   2. Remplir les vraies clés API
#   3. Ne JAMAIS commiter `config/secrets.yaml` (déjà gitignored)
#
# Structure imbriquée par provider pour permettre l'ajout futur
# (Anthropic, OpenAI, etc.) sans collision de noms.

mistral:
  api_key: "your-mistral-api-key-here"

# Exemples pour ajouts futurs :
# anthropic:
#   api_key: "your-anthropic-key-here"
# openai:
#   api_key: "your-openai-key-here"
