  </rdf:Description>
  <rdf:Description rdf:nodeID="A567">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <prov:wasDerivedFrom xml:lang="fr">Urétrite à Candida</prov:wasDerivedFrom>
    <owl:annotatedSource rdf:resource="http://data.esante.gouv.fr/atih/cim10/B37.4"/>
