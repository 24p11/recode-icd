  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Z61.4">
    <rdfs:label xml:lang="fr">Difficultés liées à de possibles sévices sexuels infligés à un enfant par une personne de son entourage immédiat</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z61"/>
    <dc:type>category</dc:type>
    <skos:notation>Z61.4</skos:notation>
    <skos:definition xml:lang="fr">Difficultés liées à une forme quelconque d'exposition ou de contact physique entre un membre adulte de la famille de l'enfant et celui-ci, ayant entraîné une excitation sexuelle, que l'enfant ait ou non participé volontairement aux actes sexuels (par exemple, contact génital, attouchements ou exposition délibérée des seins ou des organes génitaux).</skos:definition>
  </rdf:Description>
