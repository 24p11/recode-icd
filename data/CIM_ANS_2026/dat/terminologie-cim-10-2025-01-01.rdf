  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F20-F29">
    <rdfs:label xml:lang="fr">Schizophrénie, trouble schizotypique et troubles délirants</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/05"/>
    <dc:type>block</dc:type>
    <skos:notation>F20-F29</skos:notation>
    <skos:scopeNote xml:lang="fr">Ce groupe réunit la schizophrénie, catégorie la plus importante de ce groupe de troubles, le trouble schizotypique, les troubles délirants persistants et un groupe assez large de troubles psychotiques aigus et transitoires. Les troubles schizoaffectifs ont été maintenus ici, bien que leur nature reste controversée.</skos:scopeNote>
  </rdf:Description>
