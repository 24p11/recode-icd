  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/E00">
    <rdfs:label xml:lang="fr">Syndrome d'insuffisance thyroïdienne congénitale</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/E00-E07"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>maladies endémiques dues à une insuffisance en iode de l'environnement soit directe, soit résultant d'une insuffisance thyroïdienne maternelle. Certaines de ces maladies ne correspondent pas à une hypothyroïdie en cours mais sont la conséquence d'une sécrétion anormale de l'hormone thyroïdienne au cours du développement du fœtus. Le goitre endémique peut y être associé.
</xkos:inclusionNote>
    <skos:notation>E00</skos:notation>
    <skos:altLabel xml:lang="fr">maladies endémiques dues à une insuffisance en iode de l'environnement soit directe, soit résultant d'une insuffisance thyroïdienne maternelle. Certaines de ces maladies ne correspondent pas à une hypothyroïdie en cours mais sont la conséquence d'une sécrétion anormale de l'hormone thyroïdienne au cours du développement du fœtus. Le goitre endémique peut y être associé.</skos:altLabel>
    <xkos:exclusionNote>hypothyroïdie par carence inapparente en iode [E02]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/E02"/>
    <skos:scopeNote xml:lang="fr">Utiliser, au besoin, un code supplémentaire [F70-F79] pour identifier le retard mental associé. </skos:scopeNote>
  </rdf:Description>
