  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F06.6">
    <rdfs:label xml:lang="fr">Labilité [asthénie] émotionnelle organique</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
