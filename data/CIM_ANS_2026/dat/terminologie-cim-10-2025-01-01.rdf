    <dc:type>category</dc:type>
    <xkos:inclusionNote>Soins maternels pour lésions fœtales (présumées) résultant de :
 - amniocentèse
 - biopsie
 - dispositif intra-utérin
 - examens hématologiques
 - intervention chirurgicale intra-utérine
</xkos:inclusionNote>
    <skos:notation>O35.7</skos:notation>
    <skos:altLabel xml:lang="fr">Soins maternels pour lésions fœtales (présumées) résultant de amniocentèse</skos:altLabel>
