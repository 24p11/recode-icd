  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F00.0">
    <rdfs:label xml:lang="fr">Démence de la maladie d'Alzheimer, à début précoce </rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F00"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Démence dégénérative primaire de type Alzheimer, à début présénile
Démence présénile, de type Alzheimer
Maladie d'Alzheimer, type 2
</xkos:inclusionNote>
    <skos:notation>F00.0</skos:notation>
    <skos:altLabel xml:lang="fr">Démence présénile, de type Alzheimer</skos:altLabel>
    <skos:altLabel xml:lang="fr">Maladie d'Alzheimer, type 2</skos:altLabel>
