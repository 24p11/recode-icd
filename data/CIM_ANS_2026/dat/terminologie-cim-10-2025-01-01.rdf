  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F31">
    <rdfs:label xml:lang="fr">Trouble affectif bipolaire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F30-F39"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>dépression maniaque
maladie  maniacodépressive
psychose  maniacodépressive
réaction  maniacodépressive
</xkos:inclusionNote>
    <skos:notation>F31</skos:notation>
    <skos:altLabel xml:lang="fr">dépression maniaque</skos:altLabel>
    <skos:altLabel xml:lang="fr">réaction maniacodépressive</skos:altLabel>
    <skos:altLabel xml:lang="fr">maladie maniacodépressive</skos:altLabel>
    <skos:altLabel xml:lang="fr">psychose maniacodépressive</skos:altLabel>
    <xkos:exclusionNote>cyclothymie [F34.0]
trouble bipolaire, épisode maniaque isolé [F30.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F30"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F34.0"/>
    <skos:definition xml:lang="fr">Trouble caractérisé par deux ou plusieurs épisodes au cours desquels l'humeur et le niveau d'activité du sujet sont profondément perturbés, tantôt dans le sens d'une élévation de l'humeur et d'une augmentation de l'énergie et de l'activité (hypomanie ou manie), tantôt dans le sens d'un abaissement de l'humeur et d'une réduction de l'énergie et de l'activité (dépression). Les épisodes récurrents d'hypomanie ou de manie sont classés comme bipolaires.</skos:definition>
  </rdf:Description>
