  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/M21.1">
    <rdfs:label xml:lang="fr">Déformation en varus, non classée ailleurs</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
