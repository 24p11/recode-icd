  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F63.2">
    <rdfs:label xml:lang="fr">Tendance pathologique à commettre des vols [kleptomanie]</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F63"/>
    <dc:type>category</dc:type>
    <skos:notation>F63.2</skos:notation>
    <xkos:exclusionNote>mise en observation pour suspicion de trouble mental à la suite d'un vol, non confirmé [Z03.2]
vol au cours d'un trouble :
 - dépressif [F31-F33] 
 - mental organique [F00-F09] 
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F00-F09"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z03.2"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F33"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F32"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F31"/>
    <skos:definition xml:lang="fr">Trouble caractérisé par des impossibilités répétées à résister aux impulsions de vol d'objets. Les objets ne sont pas volés pour leur utilité immédiate ou leur valeur monétaire ; le sujet peut, au contraire, soit les jeter, soit les donner, soit encore les entasser. Ce comportement s'accompagne habituellement d'un état de tension croissante avant l'acte et d'un sentiment de satisfaction pendant et immédiatement après sa réalisation.</skos:definition>
  </rdf:Description>
