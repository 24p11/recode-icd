    <skos:altLabel xml:lang="fr">Polycythémie hypoxémique</skos:altLabel>
    <skos:altLabel xml:lang="fr">Polycythémie due à altitude</skos:altLabel>
    <skos:altLabel xml:lang="fr">Polycythémie relative</skos:altLabel>
    <skos:altLabel xml:lang="fr">Polycythémie due à érythropoïétine</skos:altLabel>
    <skos:altLabel xml:lang="fr">Polycythémie émotive</skos:altLabel>
    <skos:altLabel xml:lang="fr">Polycythémie néphrogène</skos:altLabel>
    <xkos:exclusionNote>polycythémie (du) :
