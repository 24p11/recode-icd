  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V27">
    <rdfs:label xml:lang="fr">Motocycliste blessé dans une collision avec un objet fixe ou stationnaire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
