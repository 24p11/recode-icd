  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V90">
    <rdfs:label xml:lang="fr">Accident de bateau entraînant la noyade et la submersion</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V90-V94"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>noyade et submersion due à:
 - chute ou saut d'un bateau en feu ou fracassé
 - naufrage de bateau
 - retournement de bateau
 - submersion de bateau
 - autre accident de bateau
</xkos:inclusionNote>
    <skos:notation>V90</skos:notation>
    <skos:altLabel xml:lang="fr">noyade et submersion due à: retournement de bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion due à: naufrage de bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion due à: submersion de bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion due à: autre accident de bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion due à: chute ou saut d'un bateau en feu ou fracassé</skos:altLabel>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes à quatre caractères s'appliquent aux catégories V90-V94 :
			
.0    Navire marchand
.1    Navire de transport de passagers
.2    Bateau de pêche
.3    Autres embarcations à moteur
.4    Bateau à voiles
.5    Canoë ou kayak
.6    Canot pneumatique (sans moteur)
.7    Ski nautique
.8    Autres embarcations sans moteur
.9    Embarcation non précisée
</skos:note>
    <xkos:exclusionNote>noyade et submersion durant un transport par eau, sans accident de bateau [V92.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/V92"/>
  </rdf:Description>
