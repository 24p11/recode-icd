  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/M94.0">
    <rdfs:label xml:lang="fr">Syndrome des articulations chondrocostales [Tietze]</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/M94"/>
