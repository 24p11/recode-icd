  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F65.2">
    <rdfs:label xml:lang="fr">Exhibitionnisme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F65"/>
    <dc:type>category</dc:type>
    <skos:notation>F65.2</skos:notation>
    <skos:definition xml:lang="fr">Tendance récurrente ou persistante à exposer les organes génitaux à des étrangers (en général du sexe opposé) ou à des gens dans des endroits publics, sans désirer ou solliciter un contact plus étroit. Il y a habituellement, mais non constamment, excitation sexuelle au moment de l'exhibition et l'acte est, en général, suivi de masturbation.</skos:definition>
  </rdf:Description>
