  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F95.1">
    <rdfs:label xml:lang="fr">Tic moteur ou vocal chronique</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F95"/>
    <dc:type>category</dc:type>
    <skos:notation>F95.1</skos:notation>
    <skos:definition xml:lang="fr">Trouble répondant aux critères d'un tic, caractérisé par la présence soit de tics moteurs soit de tics vocaux, mais pas des deux à la fois. Il peut s'agir d'un tic isolé ou, plus fréquemment, de tics multiples, persistant pendant plus d'un an.</skos:definition>
  </rdf:Description>
