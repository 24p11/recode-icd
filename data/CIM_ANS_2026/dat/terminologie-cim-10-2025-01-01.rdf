  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F23.3">
    <rdfs:label xml:lang="fr">Autre trouble psychotique aigu, essentiellement délirant</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F23"/>
