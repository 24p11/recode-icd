  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Y82">
    <rdfs:label xml:lang="fr">Appareils associés à des accidents, autres et sans précision</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Y70-Y82"/>
    <dc:type>category</dc:type>
    <skos:notation>Y82</skos:notation>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes à quatre caractères s'appliquent aux catégories Y70-Y82 :
			
.0    Appareil pour diagnostic et monitorage
.1    Appareil pour traitement (non chirurgical) et rééducation
.2    Prothèse et autres implants, matériel et accessoires
.3    Instruments, matériaux et appareils chirurgicaux (y compris les sutures)
.8    Appareils divers, non classés ailleurs
</skos:note>
  </rdf:Description>
