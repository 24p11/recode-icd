  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/I22">
    <rdfs:label xml:lang="fr">Infarctus du myocarde à répétition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/I20-I25"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>infarctus du myocarde :
 - extensif
 - récidivant
réinfarctus
</xkos:inclusionNote>
    <skos:notation>I22</skos:notation>
    <skos:altLabel xml:lang="fr">infarctus du myocarde récidivant</skos:altLabel>
    <skos:altLabel xml:lang="fr">infarctus du myocarde extensif</skos:altLabel>
    <skos:altLabel xml:lang="fr">réinfarctus</skos:altLabel>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes doivent être utilisées comme caractère supplémentaire après le quatrième caractère pour distinguer le moment de la prise en charge :
			
0    Prise en charge initiale
00    Prise en charge initiale, infarctus de 24 heures ou moins
8    Autres prises en charge
</skos:note>
    <skos:note xml:lang="fr">Pour le codage de la morbidité, cette catégorie doit être utilisée pour les infarctus de tous sites, survenant pendant 4 semaines (28 jours) à partir du précédent infarctus.
</skos:note>
    <xkos:exclusionNote>précisé comme chronique ou d'une durée de 4 semaines au moins (plus de 28 jours) depuis le début [I25.8]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/I25.8"/>
  </rdf:Description>
