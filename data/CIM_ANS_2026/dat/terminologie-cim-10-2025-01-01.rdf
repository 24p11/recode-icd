  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F02.0">
    <rdfs:label xml:lang="fr">Démence de la maladie de Pick </rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F02"/>
    <dc:type>category</dc:type>
    <skos:notation>F02.0</skos:notation>
    <atih-cim10:hasCausality rdf:resource="http://data.esante.gouv.fr/atih/cim10/G31.0"/>
    <skos:definition xml:lang="fr">Démence évoluant progressivement, débutant à l'âge mûr, caractérisée par des modifications du caractère précoces, lentement progressives, et par une détérioration sociale, aboutissant à une déficience des fonctions intellectuelles, de la mémoire et du langage, accompagnées d'une apathie, d'une euphorie et, plus rarement, de symptômes extrapyramidaux.</skos:definition>
  </rdf:Description>
