  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F92.8">
    <rdfs:label xml:lang="fr">Autres troubles mixtes des conduites et troubles émotionnels</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F92"/>
