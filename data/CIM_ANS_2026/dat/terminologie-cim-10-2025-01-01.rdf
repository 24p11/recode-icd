  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F60.6">
    <rdfs:label xml:lang="fr">Personnalité anxieuse [évitante]</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F60"/>
    <dc:type>category</dc:type>
    <skos:notation>F60.6</skos:notation>
    <skos:definition xml:lang="fr">Trouble de la personnalité caractérisé par un sentiment de tension et d'appréhension, d'insécurité et d'infériorité. Il existe un désir perpétuel d'être aimé et accepté, une hypersensibilité à la critique et au rejet, une réticence à nouer des relations et une tendance à éviter certaines activités en raison d'une exagération des dangers ou des risques potentiels de situations banales.</skos:definition>
  </rdf:Description>
