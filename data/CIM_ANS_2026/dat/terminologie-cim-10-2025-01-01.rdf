  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Y80">
    <rdfs:label xml:lang="fr">Appareils de médecine physique, associés à des accidents</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
