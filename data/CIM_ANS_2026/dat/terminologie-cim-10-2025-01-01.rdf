  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/T88">
    <rdfs:label xml:lang="fr">Autres complications de soins chirurgicaux et médicaux, non classées ailleurs</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
