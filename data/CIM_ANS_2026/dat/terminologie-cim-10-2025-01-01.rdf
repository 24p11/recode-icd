    <rdfs:label xml:lang="fr">Troubles mentaux et du comportement liés à l'utilisation de sédatifs ou d'hypnotiques - "Trouble résiduel ou psychotique de survenue tardive" - "démence"</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
