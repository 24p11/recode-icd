  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F63.8">
    <rdfs:label xml:lang="fr">Autres troubles des habitudes et des impulsions</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F63"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Trouble explosif intermittent
</xkos:inclusionNote>
    <skos:notation>F63.8</skos:notation>
    <skos:altLabel xml:lang="fr">Trouble explosif intermittent</skos:altLabel>
    <skos:definition xml:lang="fr">Autres variétés de comportements inadaptés persistants et répétés, non secondaires à un syndrome psychiatrique reconnu. Le sujet ne parvient pas, de façon répétitive, à résister à des impulsions le poussant à adopter ce comportement, avec une période prodromique de tension suivie d'un sentiment de soulagement lors de la réalisation de l'acte.</skos:definition>
  </rdf:Description>
