  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F44.1">
    <rdfs:label xml:lang="fr">Fugue dissociative</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F44"/>
    <dc:type>category</dc:type>
    <skos:notation>F44.1</skos:notation>
    <xkos:exclusionNote>fugue postcritique chez les épileptiques [G40.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/G40"/>
    <skos:definition xml:lang="fr">La fugue dissociative présente toutes les caractéristiques d'une amnésie dissociative et comporte, par ailleurs, un déplacement, en apparence motivé, dépassant le rayon du déplacement quotidien habituel. Bien qu'il existe une amnésie pour la période de la fugue, le comportement du sujet au cours de cette dernière peut paraitre parfaitement normal à des observateurs indépendants.</skos:definition>
  </rdf:Description>
