  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/R83-R89">
    <rdfs:label xml:lang="fr">Résultats anormaux de l'examen d'autres liquides, substances et tissus, sans diagnostic</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/18"/>
    <dc:type>block</dc:type>
    <skos:notation>R83-R89</skos:notation>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes peuvent être utilisées comme quatrième caractère avec les catégories R83-R89 :
			
.0    Taux anormal d'enzymes
.1    Taux anormal d'hormones
.2    Taux anormal d'autres substances médicamenteuses et biologiques
.3    Taux anormal de substances d'origine principalement non médicinale
.4    Résultats immunologiques anormaux
.5    Résultats microbiologiques anormaux
.6    Résultats cytologiques anormaux
.7    Résultats histologiques anormaux
.8    Autres résultats anormaux
.9    Résultat anormal, sans précision
</skos:note>
    <xkos:exclusionNote>résultats :
 - anormaux de l'examen (de) :
  - prénatal systématique de la mère [O28.-] 
  - sang, sans diagnostic [R70-R79] 
  - urine, sans diagnostic [R80-R82] 
 - diagnostiques anormaux classés ailleurs – voir Index alphabétique
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/R70-R79"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/O28"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/R80-R82"/>
