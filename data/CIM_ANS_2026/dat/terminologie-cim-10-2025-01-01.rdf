  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F64.0">
    <rdfs:label xml:lang="fr">Transsexualisme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F64"/>
    <dc:type>category</dc:type>
    <skos:notation>F64.0</skos:notation>
    <skos:definition xml:lang="fr">Il s'agit d'un désir de vivre et d'être accepté en tant que personne appartenant au sexe opposé. Ce désir s'accompagne habituellement d'un sentiment de malaise ou d'inadaptation par rapport à son sexe anatomique et du souhait de subir une intervention chirurgicale ou un traitement hormonal afin de rendre son corps aussi conforme que possible au sexe désiré.</skos:definition>
  </rdf:Description>
