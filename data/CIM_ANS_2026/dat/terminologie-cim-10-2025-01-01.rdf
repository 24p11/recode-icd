  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/M24.1">
    <rdfs:label xml:lang="fr">Autres atteintes du cartilage articulaire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
