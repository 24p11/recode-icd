  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F93.2">
    <rdfs:label xml:lang="fr">Anxiété sociale de l'enfance</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F93"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Évitement de l'enfance et de l'adolescence
</xkos:inclusionNote>
    <skos:notation>F93.2</skos:notation>
    <skos:altLabel xml:lang="fr">Évitement de l'enfance et de l'adolescence</skos:altLabel>
    <skos:definition xml:lang="fr">Trouble caractérisé par une attitude de réserve vis-à-vis des étrangers et par une crainte ou une peur concernant les situations sociales nouvelles, inhabituelles ou inquiétantes. Cette catégorie ne doit être utilisée que lorsque de telles craintes apparaissent dans la petite enfance, sont à l'évidence excessives et s'accompagnent d'une perturbation du fonctionnement social.</skos:definition>
  </rdf:Description>
