  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F00.1">
    <rdfs:label xml:lang="fr">Démence de la maladie d'Alzheimer, à début tardif </rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F00"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Démence dégénérative primaire de type Alzheimer, à début sénile
Démence sénile, de type Alzheimer (DSTA)
Maladie d'Alzheimer, type 1
</xkos:inclusionNote>
    <skos:notation>F00.1</skos:notation>
    <skos:altLabel xml:lang="fr">Démence sénile, de type Alzheimer (DSTA)</skos:altLabel>
    <skos:altLabel xml:lang="fr">Maladie d'Alzheimer, type 1</skos:altLabel>
    <skos:altLabel xml:lang="fr">Démence dégénérative primaire de type Alzheimer, à début sénile</skos:altLabel>
    <atih-cim10:hasCausality rdf:resource="http://data.esante.gouv.fr/atih/cim10/G30.1"/>
    <skos:definition xml:lang="fr">Démence de la maladie d'Alzheimer survenant après l'âge de 65 ans, habituellement à la fin de la huitième décennie ou au-delà ; elle évolue de façon lentement progressive et se caractérise essentiellement par une altération de la mémoire.</skos:definition>
  </rdf:Description>
