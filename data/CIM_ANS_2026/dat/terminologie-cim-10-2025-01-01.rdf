  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Z61.5">
    <rdfs:label xml:lang="fr">Difficultés liées à de possibles sévices sexuels infligés à un enfant par une personne étrangère à son entourage immédiat</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z61"/>
