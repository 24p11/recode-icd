  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V17">
    <rdfs:label xml:lang="fr">Cycliste blessé dans une collision avec un objet fixe ou stationnaire</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V10-V19"/>
