  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F10">
    <rdfs:label xml:lang="fr">Troubles mentaux et du comportement liés à l'utilisation d'alcool</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
