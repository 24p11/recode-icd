  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V91">
    <rdfs:label xml:lang="fr">Accident de bateau provoquant d'autres lésions traumatiques</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V90-V94"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>brulure au cours d'un incendie de bateau
chute due à une collision ou un autre accident du bateau
écrasement :
 - entre bateaux entrant en collision
 - par une embarcation de sauvetage après abandon du bateau
- heurt par :
 - bateau ou une partie de bateau après chute ou saut d'un bateau endommagé
 - chute d'objet par suite d'un accident du bateau
lésion traumatique au cours d'un accident de bateau impliquant une collision
toute lésion traumatique, sauf noyade et submersion, résultant de l'accident du bateau
</xkos:inclusionNote>
    <skos:notation>V91</skos:notation>
    <skos:altLabel xml:lang="fr">chute due à une collision ou un autre accident du bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">écrasement par une embarcation de sauvetage après abandon du bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">lésion traumatique au cours d'un accident de bateau impliquant une collision</skos:altLabel>
    <skos:altLabel xml:lang="fr">brulure au cours d'un incendie de bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">heurt par bateau ou une partie de bateau après chute ou saut d'un bateau endommagé</skos:altLabel>
    <skos:altLabel xml:lang="fr">heurt par chute d'objet par suite d'un accident du bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">écrasement entre bateaux entrant en collision</skos:altLabel>
    <skos:altLabel xml:lang="fr">toute lésion traumatique, sauf noyade et submersion, résultant de l'accident du bateau</skos:altLabel>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes à quatre caractères s'appliquent aux catégories V90-V94 :
			
.0    Navire marchand
.1    Navire de transport de passagers
.2    Bateau de pêche
.3    Autres embarcations à moteur
.4    Bateau à voiles
.5    Canoë ou kayak
.6    Canot pneumatique (sans moteur)
.7    Ski nautique
.8    Autres embarcations sans moteur
.9    Embarcation non précisée
</skos:note>
    <xkos:exclusionNote>brulures dues à un incendie localisé ou une explosion à bord d'un bateau [V93.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/V93"/>
  </rdf:Description>
