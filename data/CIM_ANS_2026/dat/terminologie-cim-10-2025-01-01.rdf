  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F32.3">
    <rdfs:label xml:lang="fr">Épisode dépressif sévère avec symptômes psychotiques</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F32"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Épisodes isolés de :
 - dépression :
  - majeure [caractérisée] avec symptômes psychotiques
  - psychotique
 - psychose dépressive :
  - psychogène
  - réactionnelle
</xkos:inclusionNote>
    <skos:notation>F32.3</skos:notation>
    <skos:altLabel xml:lang="fr">Épisodes isolés de psychose dépressive psychogène</skos:altLabel>
    <skos:altLabel xml:lang="fr">Épisodes isolés de dépression majeure [caractérisée] avec symptômes psychotiques</skos:altLabel>
    <skos:altLabel xml:lang="fr">Épisodes isolés de psychose dépressive réactionnelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">Épisodes isolés de dépression psychotique</skos:altLabel>
    <skos:definition xml:lang="fr">Épisode dépressif correspondant à la description d'un épisode dépressif sévère [F32.2] mais s'accompagnant par ailleurs d'hallucinations, d'idées délirantes ou d'un ralentissement psychomoteur ou d'une stupeur d'une gravité telle que les activités sociales habituelles sont impossibles ; il peut exister un danger vital en raison d'un suicide, d'une déshydratation ou d'une dénutrition. Les hallucinations et les idées délirantes peuvent être congruentes ou non congruentes à l'humeur. </skos:definition>
  </rdf:Description>
