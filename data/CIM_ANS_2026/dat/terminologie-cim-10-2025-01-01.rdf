  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F18.4">
    <rdfs:label xml:lang="fr">Troubles mentaux et du comportement liés à l'utilisation de solvants volatils - " Syndrome de sevrage avec délirium "</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F18"/>
