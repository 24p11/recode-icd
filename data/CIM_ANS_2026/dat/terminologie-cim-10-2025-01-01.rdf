  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/J09">
    <rdfs:label xml:lang="fr">Grippe, à virus grippal zoonotique ou pandémique identifié</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/J09-J18"/>
    <dc:type>category</dc:type>
    <skos:notation>J09</skos:notation>
    <skos:note xml:lang="fr">pour l'utilisation de cette catégorie, il faut se référer aux recommandations du programme mondial de lutte contre la grippe de l'OMS (http://www.who.int/influenza/fr/)
</skos:note>
    <xkos:exclusionNote>infection SAI [A49.2]  à Haemophilus influenzae [H. influenzae]
méningite [G00.0]  à Haemophilus influenzae [H. influenzae]
pneumopathie [J14]  à Haemophilus influenzae [H. influenzae]
grippe à virus grippal saisonnier identifié  [J10.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/J14"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/J10"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/A49.2"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/G00.0"/>
    <skos:definition xml:lang="fr">Grippe causée par des souches virales d’importance épidémiologique particulière avec transmission de l’animal à l’homme ou transmission interhumaine.</skos:definition>
    <skos:scopeNote xml:lang="fr">Utiliser, au besoin, un code supplémentaire pour identifier la pneumopathie ou d’autres manifestations.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/U09">
