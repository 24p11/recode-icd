  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/W94">
    <rdfs:label xml:lang="fr">Exposition à une dépression et une hyperpression et à des changements de pression barométriques</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/W85-W99"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>modification brusque de la pression de l'air dans un aéronef, au cours de la montée ou de la descente
pression élevée de l'air due à une rapide descente dans l'eau
réduction de la pression atmosphérique lors de la montée en surface au cours de :
 - descente sous terre
 - plongée sousmarine
- vie ou séjour prolongé en haute altitude entraînant :
 - anoxie
 - barodontalgie
 - hypoxie
 - mal des montagnes
 - otite barotraumatique
</xkos:inclusionNote>
    <skos:notation>W94</skos:notation>
    <skos:altLabel xml:lang="fr">vie ou séjour prolongé en haute altitude entraînant hypoxie</skos:altLabel>
    <skos:altLabel xml:lang="fr">réduction de la pression atmosphérique lors de la montée en surface au cours de descente sous terre</skos:altLabel>
    <skos:altLabel xml:lang="fr">pression élevée de l'air due à une rapide descente dans l'eau</skos:altLabel>
    <skos:altLabel xml:lang="fr">vie ou séjour prolongé en haute altitude entraînant otite barotraumatique</skos:altLabel>
    <skos:altLabel xml:lang="fr">modification brusque de la pression de l'air dans un aéronef, au cours de la montée ou de la descente</skos:altLabel>
    <skos:altLabel xml:lang="fr">vie ou séjour prolongé en haute altitude entraînant barodontalgie</skos:altLabel>
