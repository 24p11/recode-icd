  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F51.1">
    <rdfs:label xml:lang="fr">Hypersomnie non organique</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F51"/>
    <dc:type>category</dc:type>
    <skos:notation>F51.1</skos:notation>
    <xkos:exclusionNote>hypersomnie organique [G47.1]
narcolepsie [G47.4]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/G47.4"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/G47.1"/>
    <skos:definition xml:lang="fr">L'hypersomnie est un état défini soit par une somnolence diurne excessive et des attaques de sommeil non expliquées par une durée inadéquate de sommeil, soit par des périodes de transition prolongées entre sommeil et état d'éveil complet lors du réveil. En l'absence d'un facteur organique expliquant la survenue d'une hypersomnie, cet état est habituellement attribuable à un trouble mental.</skos:definition>
  </rdf:Description>
