  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V66">
    <rdfs:label xml:lang="fr">Occupant d'un véhicule lourd blessé dans une collision avec un autre véhicule sans moteur</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V60-V69"/>
