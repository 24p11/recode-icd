  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F51.3">
    <rdfs:label xml:lang="fr">Somnambulisme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F51"/>
    <dc:type>category</dc:type>
    <skos:notation>F51.3</skos:notation>
    <skos:definition xml:lang="fr">Altération de l'état de conscience tenant à la fois du sommeil et de la veille. Durant un épisode de somnambulisme, l'individu se lève du lit, habituellement au cours du premier tiers du sommeil nocturne et il déambule ; ces manifestations correspondent à un niveau réduit de vigilance, de réactivité et d'habilité motrice. Au réveil, le sujet ne garde habituellement aucun souvenir de l'épisode.</skos:definition>
  </rdf:Description>
