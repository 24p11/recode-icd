    <skos:notation>F52.2</skos:notation>
    <skos:altLabel xml:lang="fr">Trouble de érection chez l'homme</skos:altLabel>
    <skos:altLabel xml:lang="fr">Trouble de réponse sexuelle chez la femme</skos:altLabel>
    <skos:altLabel xml:lang="fr">Impuissance psychogène</skos:altLabel>
    <xkos:exclusionNote>impuissance d'origine organique [N48.4]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/N48.4"/>
    <skos:definition xml:lang="fr">Le problème principal chez les hommes est un trouble des fonctions érectiles (difficulté à développer ou à maintenir une érection adéquate pour un rapport satisfaisant). Chez les femmes, le problème principal est une sécheresse vaginale ou un manque de lubrification.</skos:definition>
  </rdf:Description>
