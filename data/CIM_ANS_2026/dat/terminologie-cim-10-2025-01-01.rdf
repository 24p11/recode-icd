  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V73">
    <rdfs:label xml:lang="fr">Occupant d'un autobus blessé dans une collision avec une automobile ou une camionnette</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V70-V79"/>
