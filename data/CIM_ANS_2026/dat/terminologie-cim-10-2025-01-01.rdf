  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/O06">
    <rdfs:label xml:lang="fr">Avortement, sans précision</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/O00-O08"/>
