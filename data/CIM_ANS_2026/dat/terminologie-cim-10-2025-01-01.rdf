  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V42">
    <rdfs:label xml:lang="fr">Occupant d'une automobile blessé dans une collision avec un véhicule à moteur à deux ou trois roues</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V40-V49"/>
