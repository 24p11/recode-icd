  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Z59.11">
    <rdfs:label xml:lang="fr">Logement sans confort</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z59.1"/>
