  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F93.1">
    <rdfs:label xml:lang="fr">Trouble anxieux phobique de l'enfance</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F93"/>
    <dc:type>category</dc:type>
    <skos:notation>F93.1</skos:notation>
    <xkos:exclusionNote>anxiété généralisée [F41.1]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F41.1"/>
    <skos:definition xml:lang="fr">Trouble caractérisé par la présence de craintes de l'enfance, hautement spécifiques d'une phase de développement, et survenant (à un certain degré) chez la plupart des enfants, mais dont l'intensité est anormale. Les autres craintes qui surviennent dans l'enfance, mais qui ne font pas partie du développement psychosocial normal (par exemple une agoraphobie), doivent être classées dans la catégorie appropriée de la section F40-F48.</skos:definition>
  </rdf:Description>
