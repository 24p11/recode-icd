  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Z62.6">
    <rdfs:label xml:lang="fr">Pression parentale inappropriée et autres défauts de l'éducation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z62"/>
    <dc:type>category</dc:type>
    <skos:notation>Z62.6</skos:notation>
    <skos:definition xml:lang="fr">Parents forçant l'enfant à se comporter de façon différente de la norme locale, que ce soit par rapport à son sexe (en habillant un garçon en fille), par rapport à son âge (en forçant un enfant à prendre des responsabilités plus lourdes qu'il ne peut en assumer pour son âge) ou pour d'autres raisons (obligeant l'enfant à entreprendre des activités contre son gré ou des activités trop difficiles pour lui).</skos:definition>
  </rdf:Description>
