    <rdfs:label xml:lang="fr">Infarctus aigu du myocarde</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/I20-I25"/>
