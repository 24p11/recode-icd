  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/R84">
    <rdfs:label xml:lang="fr">Résultats anormaux de prélèvements effectués sur l'appareil respiratoire et le thorax</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/R83-R89"/>
    <dc:type>category</dc:type>
    <skos:notation>R84</skos:notation>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes peuvent être utilisées comme quatrième caractère avec les catégories R83-R89 :
			
.0    Taux anormal d'enzymes
.1    Taux anormal d'hormones
.2    Taux anormal d'autres substances médicamenteuses et biologiques
.3    Taux anormal de substances d'origine principalement non médicinale
.4    Résultats immunologiques anormaux
.5    Résultats microbiologiques anormaux
.6    Résultats cytologiques anormaux
.7    Résultats histologiques anormaux
.8    Autres résultats anormaux
.9    Résultat anormal, sans précision
</skos:note>
    <xkos:exclusionNote>expectorations sanglantes [R04.2]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/R04.2"/>
    <skos:scopeNote xml:lang="fr">
				Résultats anormaux de :
				expectoration
			</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">
				Résultats anormaux de :
				liquide pleural
			</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">
				Résultats anormaux de :
				sécrétions nasales
			</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">
				Résultats anormaux de :
				prélèvements de gorge
			</skos:scopeNote>
    <skos:scopeNote xml:lang="fr">
