  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/G11.1">
    <rdfs:label xml:lang="fr">Ataxie cérébelleuse à début précoce</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/G11"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Ataxie (de) :
 - cérébelleuse précoce avec :
  - myoclonies [Ramsay Hunt]
  - persistance des réflexes tendineux
  - tremblement essentiel
 - Friedreich (autosomique récessive)
 - spinocérébelleuse récessive liée au chromosome X
</xkos:inclusionNote>
    <skos:notation>G11.1</skos:notation>
    <skos:altLabel xml:lang="fr">Ataxie (de) cérébelleuse précoce avec tremblement essentiel</skos:altLabel>
    <skos:altLabel xml:lang="fr">Ataxie (de) spinocérébelleuse récessive liée au chromosome X</skos:altLabel>
    <skos:altLabel xml:lang="fr">Ataxie (de) Friedreich (autosomique récessive)</skos:altLabel>
    <skos:altLabel xml:lang="fr">Ataxie (de) cérébelleuse précoce avec persistance des réflexes tendineux</skos:altLabel>
    <skos:altLabel xml:lang="fr">Ataxie (de) cérébelleuse précoce avec myoclonies [Ramsay Hunt]</skos:altLabel>
    <skos:note xml:lang="fr">Début habituellement avant l'âge de 20 ans
</skos:note>
  </rdf:Description>
