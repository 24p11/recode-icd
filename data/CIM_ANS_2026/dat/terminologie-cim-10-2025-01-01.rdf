  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F45.2">
    <rdfs:label xml:lang="fr">Trouble hypocondriaque</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F45"/>
