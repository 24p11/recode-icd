    <atih-cim10:hasCausality rdf:resource="http://data.esante.gouv.fr/atih/cim10/G30.0"/>
    <skos:definition xml:lang="fr">Démence de la maladie d'Alzheimer survenant avant l'âge de 65 ans, évoluant assez rapidement vers une détérioration et comportant de multiples perturbations marquées des fonctions corticales supérieures.</skos:definition>
  </rdf:Description>
