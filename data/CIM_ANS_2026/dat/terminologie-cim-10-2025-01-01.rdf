  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F02.1">
    <rdfs:label xml:lang="fr">Démence de la maladie de Creutzfeldt–Jakob </rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F02"/>
    <dc:type>category</dc:type>
    <skos:notation>F02.1</skos:notation>
    <atih-cim10:hasCausality rdf:resource="http://data.esante.gouv.fr/atih/cim10/A81.0"/>
    <skos:definition xml:lang="fr">Démence évoluant progressivement, comportant des signes neurologiques étendus, due à des altérations neuropathologiques spécifiques que l'on suppose provoquées par un agent transmissible. Elle débute habituellement à l'âge mûr ou plus tard mais peut débuter chez l'adulte à n'importe quel âge. Son évolution est subaigüe, aboutissant à la mort en un à deux ans.</skos:definition>
  </rdf:Description>
