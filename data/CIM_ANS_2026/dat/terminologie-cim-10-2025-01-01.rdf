  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F30.2">
    <rdfs:label xml:lang="fr">Manie avec symptômes psychotiques</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F30"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>Stupeur maniaque
</xkos:inclusionNote>
    <skos:notation>F30.2</skos:notation>
    <skos:altLabel xml:lang="fr">Stupeur maniaque</skos:altLabel>
    <skos:definition xml:lang="fr">Présence, associée au tableau clinique décrit en F30.1, d'idées délirantes (habituellement de grandeur) ou d'hallucinations (habituellement à type de voix parlant directement au sujet), ou d'une agitation, d'une activité motrice excessive et d'une fuite des idées d'une gravité telle que le sujet devient incompréhensible ou hors d'état de communiquer normalement.</skos:definition>
  </rdf:Description>
