articulation du coude
</xkos:inclusionNote>
    <skos:notation>M84.32</skos:notation>
    <skos:altLabel xml:lang="fr">articulation du coude</skos:altLabel>
    <skos:altLabel xml:lang="fr">humérus</skos:altLabel>
    <prov:wasGeneratedBy rdf:resource="http://data.esante.gouv.fr/atih/cim10/activity/ModifiedByConversion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F84">
    <rdfs:label xml:lang="fr">Troubles envahissants du développement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F80-F89"/>
    <dc:type>category</dc:type>
    <skos:notation>F84</skos:notation>
    <skos:definition xml:lang="fr">Groupe de troubles caractérisés par des altérations qualitatives des interactions sociales réciproques et des modalités de communication, ainsi que par un répertoire d'intérêts et d'activités restreint, stéréotypé et répétitif. Ces anomalies qualitatives constituent une caractéristique envahissante du fonctionnement du sujet, en toutes situations.</skos:definition>
    <skos:scopeNote xml:lang="fr">Utiliser, au besoin, un code supplémentaire pour identifier toute affection médicale associée, de même que le retard mental.</skos:scopeNote>
  </rdf:Description>
