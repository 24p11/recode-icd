  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/O96">
    <rdfs:label xml:lang="fr">Mort d'origine obstétricale, survenant plus de 42 jours mais moins d'un an après l'accouchement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/O94-O99"/>
    <dc:type>category</dc:type>
    <skos:notation>O96</skos:notation>
    <skos:note xml:lang="fr">Cette catégorie doit être utilisée pour le codage de la mort d'origine obstétricale (affections classées dans les catégories O00-O75, O85-O92 et O98-O99) survenant plus de 42 jours et moins d'un an après l'accouchement.
</skos:note>
    <xkos:exclusionNote>affections décrites comme séquelles ou effets tardifs de cause obstétricale n'entrainant pas le décès [O94]
mort de séquelles ou d'effets tardifs relevant d'une cause obstétricale [O97.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/O97"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/O94"/>
    <skos:scopeNote xml:lang="fr">Utiliser, au besoin, un code supplémentaire pour identifier la cause obstétricale (directe) (indirecte).</skos:scopeNote>
  </rdf:Description>
