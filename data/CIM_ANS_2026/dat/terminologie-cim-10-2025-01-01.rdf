  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/F31.3">
    <rdfs:label xml:lang="fr">Trouble affectif bipolaire, épisode actuel de dépression légère ou moyenne</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/F31"/>
    <dc:type>category</dc:type>
    <skos:notation>F31.3</skos:notation>
    <skos:definition xml:lang="fr">Le sujet est actuellement déprimé, comme au cours d'un épisode dépressif d'intensité légère ou moyenne [F32.0 ou F32.1] , et a eu dans le passé au moins un épisode hypomaniaque, maniaque ou mixte bien documenté. </skos:definition>
  </rdf:Description>
