  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/V92">
    <rdfs:label xml:lang="fr">Noyade et submersion durant un transport par eau, sans accident de bateau</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/V90-V94"/>
    <dc:type>category</dc:type>
    <xkos:inclusionNote>noyade et submersion résultant d'un accident tel que :
 - chute :
  - du haut du bateau
  - du haut de la passerelle
  - par dessus bord
 - éjection par dessus bord provoquée par les mouvements du navire
- noyade et submersion résultant d'un accident tel que:
 - enlèvement par une lame
</xkos:inclusionNote>
    <skos:notation>V92</skos:notation>
    <skos:altLabel xml:lang="fr">noyade et submersion résultant d'un accident tel que chute du haut de la passerelle</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion résultant d'un accident tel que chute par dessus bord</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion résultant d'un accident tel que chute du haut du bateau</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion résultant d'un accident tel que éjection par dessus bord provoquée par les mouvements du navire</skos:altLabel>
    <skos:altLabel xml:lang="fr">noyade et submersion résultant d'un accident tel que: enlèvement par une lame</skos:altLabel>
    <skos:note xml:lang="fr">
				Les subdivisions suivantes à quatre caractères s'appliquent aux catégories V90-V94 :
			
.0    Navire marchand
.1    Navire de transport de passagers
.2    Bateau de pêche
.3    Autres embarcations à moteur
.4    Bateau à voiles
.5    Canoë ou kayak
.6    Canot pneumatique (sans moteur)
.7    Ski nautique
.8    Autres embarcations sans moteur
.9    Embarcation non précisée
</skos:note>
    <xkos:exclusionNote>noyade et submersion d'un nageur ou d'un plongeur qui saute volontairement d'un bateau non impliqué dans un accident [W69.-]  [W73.-]
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/W69"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/W73"/>
  </rdf:Description>
