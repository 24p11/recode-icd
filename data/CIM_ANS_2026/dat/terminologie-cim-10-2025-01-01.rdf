    <skos:altLabel xml:lang="fr">Psychose schizophréniforme de courte durée</skos:altLabel>
    <xkos:exclusionNote>trouble :
 - délirant organique [d'allure schizophrénique] [F06.2] 
 - schizophréniforme SAI [F20.8] 
</xkos:exclusionNote>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F06.2"/>
    <atih-cim10:exclusion rdf:resource="http://data.esante.gouv.fr/atih/cim10/F20.8"/>
    <skos:definition xml:lang="fr">Trouble psychotique aigu caractérisé par la présence de symptômes psychotiques relativement stables, justifiant un diagnostic de schizophrénie, mais persistant moins d'un mois. Les caractéristiques polymorphes instables décrites en F23.0 sont absentes. Quand les symptômes schizophréniques persistent, le diagnostic doit être modifié pour celui de schizophrénie [F20.-] . </skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/M21.8">
    <rdfs:label xml:lang="fr">Autres déformations précisées des membres</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
