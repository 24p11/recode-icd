  <rdf:Description rdf:about="http://data.esante.gouv.fr/atih/cim10/Z62.2">
    <rdfs:label xml:lang="fr">Éducation dans une institution</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://data.esante.gouv.fr/atih/cim10/Z62"/>
    <dc:type>category</dc:type>
    <skos:notation>Z62.2</skos:notation>
    <skos:definition xml:lang="fr">Prise en charge éducative de groupe dans laquelle les responsabilités parentales sont essentiellement assumées par un établissement quelconque (pensionnat pour enfants, orphelinat, home d'enfants) ou séjour prolongé de l'enfant dans un hôpital, une maison de convalescence ou l'équivalent, sans la présence à ses côtés d'au moins l'un de ses parents.</skos:definition>
  </rdf:Description>
