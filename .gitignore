# Python / packaging
__pycache__/
*.pyc
*.egg-info/
build/
dist/
config.py

# uv / venv
.venv/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Bibliothèque de fiches CIM-10 générée par `recode-icd cards build`
# Les fiches elles-mêmes ne sont pas versionnées (régénérables en ~1,5 min).
# Seul l'index est conservé comme inventaire de référence.
outputs/cards_library/*
!outputs/cards_library/_index.csv

# Bibliothèque du profil `controle` (tous les codes, D4) : même règle.
outputs/cards_library_controle/*
!outputs/cards_library_controle/_index.csv

# Idem pour la bibliothèque de fiches catégories 3-car
# (`recode-icd cards build-categories`, ~2 054 fiches, ~30 s).
outputs/cards_library_categories/*
!outputs/cards_library_categories/_index.csv
outputs/cards_library_categories/*
!outputs/cards_library_categories/_index.csv

# Sorties exploratoires LLM (générations Mistral, etc.)
outputs/llm_synonymes_test.jsonl

# Génération massive batch LLM phase 2
# (batches intermédiaires + JSONL consolidé, ~50-100 Mo, ~50 € à régénérer).
outputs/llm_synonymes/

# Secrets et configuration locale (clés API)
# Voir config/secrets.yaml.example pour la structure.
config/secrets.yaml

# Sauvegarde de curations manuelles en cours — filet de sécurité,
# à supprimer une fois trié.
data/guide_mco/_curation_rf_sauvegarde/
